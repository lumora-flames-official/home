{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    /* `src/data/catalog.json` is written by the local CMS and imported as the
       catalog dataset, so the compiler has to be able to read a .json module.
       Without this, `tsc -b` fails before Vite ever sees the file. */
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    /* `strict` is required, not just preferred: without `strictNullChecks`,
       TypeScript cannot discriminate a union on a boolean literal, so
       `if (result.ok)` narrows nothing and the `ok: false` arm's fields are
       reported as missing. See `VerificationResult` in src/lib/verification.ts. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
